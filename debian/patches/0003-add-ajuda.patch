Index: gnome-shell-extension-gsconnect/src/preferences/service.js
===================================================================
--- gnome-shell-extension-gsconnect.orig/src/preferences/service.js
+++ gnome-shell-extension-gsconnect/src/preferences/service.js
@@ -430,6 +430,32 @@ export const Window = GObject.registerCl
         Gio.AppInfo.launch_default_for_uri_async(uri, null, null, null);
     }
 
+    _onHelp(){
+	    let [success, pid, stdin, stdout, stderr] = GLib.spawn_async_with_pipes(
+		    null,               // caminho do diretório de trabalho
+		    ['evince', '/var/opt/policorp-gsconnect/guia-gsconnect.pdf'],// comando e seus argumentos
+		    null,               // variáveis de ambiente
+		    GLib.SpawnFlags.SEARCH_PATH, // flags de spawn
+		    null                // função de callback para quando o processo terminar
+	    );
+
+	    if (success) {
+		    let inputStream = new GLib.IOChannel({unix_fd: stdin});
+		    inputStream.write('');
+		    inputStream.close();
+
+		    // Leia dados do pipe de saída (stdout) do processo
+		    let outputStream = new GLib.IOChannel({unix_fd: stdout});
+		    let [result, output] = outputStream.read_to_end();
+		    outputStream.close();
+
+		    print('Saída do processo:', output);
+	    } else {
+		    print('Erro ao executar o comando: ' + stderr);
+	    }
+    }
+
+
     /*
      * HeaderBar Callbacks
      */
