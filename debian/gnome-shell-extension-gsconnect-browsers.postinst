#!/bin/sh

set -e

#DEBHELPER#

mkdir -p /etc/opt/chrome/native-messaging-hosts
if [ ! -e /etc/opt/chrome/native-messaging-hosts/org.gnome.shell.extensions.gsconnect.json ]; then
  ln -sf /usr/share/chrome-gnome-shell/org.gnome.shell.extensions.gsconnect.json /etc/opt/chrome/native-messaging-hosts/
fi

exit 0
